NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/cloud-agent
FRONTEND_ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=replace-with-client-id
GITHUB_APP_ID=replace-with-numeric-app-id
GITHUB_APP_PRIVATE_KEY=replace-with-github-app-private-key
GITHUB_CLIENT_SECRET=replace-with-client-secret
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret
GITHUB_APP_SLUG=exlantern
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
